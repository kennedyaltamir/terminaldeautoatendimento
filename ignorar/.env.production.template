# ==============================================================================
# MESAFLOW PRODUCTION ENVIRONMENT CONFIGURATION
# Renomeie este arquivo para .env em produção ou configure no painel do Render/Vercel
# ==============================================================================

# --- 1. INFRAESTRUTURA (CRÍTICO) ---
# Ambiente (production, staging, development)
ENVIRONMENT=production

# URL do Banco de Dados (Neon.tech)
# IMPORTANTE: Use a URL com "-pooler" para suportar alta concorrência.
DATABASE_URL=

# URL do Redis (Upstash ou Render Redis)
REDIS_URL=

# Chave Secreta para Assinatura de Tokens JWT
SECRET_KEY=

# --- 2. STORAGE (AWS S3 / R2) ---
# Obrigatório para persistência de imagens em produção
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION=us-east-1
# Opcional: Use se for Cloudflare R2 ou MinIO
AWS_ENDPOINT_URL=

# --- 3. FRONTEND & DOMÍNIOS ---
NEXT_PUBLIC_API_URL=https://api.seudominio.com.br/api
NEXT_PUBLIC_WS_URL=wss://api.seudominio.com.br/ws
NEXT_PUBLIC_ROOT_DOMAIN=mesaflow.com.br

# --- 4. FINTECH (PAGAMENTOS) ---
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...

MP_ACCESS_TOKEN=APP_USR-...
MP_APP_ID=
MP_CLIENT_SECRET=

# --- 5. FISCAL (NFC-e) ---
FISCAL_ENV=production
FISCAL_PROVIDER=focus
FISCAL_TOKEN=
FISCAL_PRODUCTION_CONFIRMED=true

# --- 6. NOTIFICAÇÕES & MARKETING ---
WHATSAPP_API_URL=
WHATSAPP_INSTANCE=
WHATSAPP_API_TOKEN=

SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@mesaflow.com.br

GOOGLE_CLIENT_ID=

# --- 7. OBSERVABILIDADE ---
SENTRY_DSN_BACKEND=
NEXT_PUBLIC_SENTRY_DSN=
