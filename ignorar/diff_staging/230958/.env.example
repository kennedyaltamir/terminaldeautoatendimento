# ==============================================================================
# MESAFLOW OS - TEMPLATE DE AMBIENTE (v3.0 Enterprise)
# ==============================================================================

# --- CORE ---
ENVIRONMENT=development
DEBUG=True
DATABASE_URL=postgresql://usuario:senha@localhost:5432/mesaflow_db
REDIS_URL=redis://localhost:6379/0

# --- SECURITY ---
SECRET_KEY=  # openssl rand -hex 32
SUPER_ADMIN_SECRET= # Chave mestre para scripts de suporte

# --- FINTECH ---
STRIPE_SECRET_KEY= # sk_live_... ou sk_test_...
STRIPE_WEBHOOK_SECRET= # whsec_... (Obtido ao configurar o webhook no Stripe)
STRIPE_PRO_PRICE_ID= # price_... (ID do produto recorrente no Stripe)

MP_ACCESS_TOKEN= # APP_USR-...
MP_APP_ID= # ID da aplicação no Mercado Pago
MP_CLIENT_SECRET= # Secret da aplicação
MP_REDIRECT_URI=http://localhost:3000/admin/payment/callback

# --- INTEGRATIONS ---
IFOOD_CLIENT_ID= # Obtido no portal do desenvolvedor iFood
IFOOD_CLIENT_SECRET=
IFOOD_WEBHOOK_SECRET= # Chave para validar assinaturas HMAC do iFood

WHATSAPP_API_URL= # URL da Evolution API (ex: http://localhost:8080)
WHATSAPP_API_TOKEN= # API Key global da Evolution
WHATSAPP_INSTANCE= # Nome da instância (ex: MesaFlow_Prod)

# --- FISCAL ---
FISCAL_PROVIDER=focus
FISCAL_ENV=sandbox # sandbox ou production
FISCAL_TOKEN= # Token obtido no painel da Focus NFe
FISCAL_PRODUCTION_CONFIRMED=false

# --- INFRA ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

AWS_BUCKET_NAME=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL= # Preencha apenas se usar Cloudflare R2 ou MinIO

# --- OBSERVABILITY ---
SENTRY_DSN_BACKEND=
NEXT_PUBLIC_SENTRY_DSN=

# --- FRONTEND / MOBILE ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_ROOT_DOMAIN=localhost
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
