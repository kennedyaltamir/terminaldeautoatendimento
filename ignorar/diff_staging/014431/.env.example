# ==============================================================================
# MESAFLOW OS — DEFINITIVE ENVIRONMENT TEMPLATE (GOLD MASTER v4.7)
# LAST_MODIFIED: 2026-01-15
# ==============================================================================

# --- CORE & RUNTIME ---
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=generate_a_secure_hex_32_chars # openssl rand -hex 32
DATABASE_URL=postgresql://user:pass@host:5432/db
REDIS_URL=redis://localhost:6379/0

# --- SECURITY & SUPPORT ---
# Chave mestre para o modo Impersonate (Suporte Técnico)
SUPER_ADMIN_SECRET=sua_chave_mestre_ultra_segura

# --- OBSERVABILITY (SENTRY) ---
SENTRY_DSN_BACKEND=https://key@o0.ingest.sentry.io/id
NEXT_PUBLIC_SENTRY_DSN=https://key@o0.ingest.sentry.io/id

# --- FINTECH: MERCADO PAGO (Operational) ---
# Usado para Pix na mesa e Split de comissões
MP_ACCESS_TOKEN=APP_USR-xxxx-xxxx
MP_APP_ID=xxxx
MP_CLIENT_SECRET=xxxx
MP_REDIRECT_URI=http://localhost:3000/admin/payment/callback/mercadopago

# --- FINTECH: STRIPE (SaaS Billing) ---
# Usado para cobrar a mensalidade dos lojistas (MesaFlow Pro)
STRIPE_SECRET_KEY=sk_live_xxxx
STRIPE_PRO_PRICE_ID=price_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx

# --- COMMUNICATION: WHATSAPP (Evolution API) ---
WHATSAPP_API_URL=https://api.sua-instancia.com
WHATSAPP_API_TOKEN=sua_api_key_segura
WHATSAPP_INSTANCE=MesaFlow_Default

# --- MARKETPLACE: IFOOD ---
IFOOD_CLIENT_ID=xxxx
IFOOD_CLIENT_SECRET=xxxx
IFOOD_WEBHOOK_SECRET=xxxx

# --- FISCAL: FOCUS NFE ---
FISCAL_PROVIDER=focus
FISCAL_ENV=sandbox
FISCAL_TOKEN=xxxx
FISCAL_PRODUCTION_CONFIRMED=false

# --- INFRA: EMAIL (SMTP) ---
# Usado para recuperação de senha e alertas de sistema
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-de-app

# --- INFRA: STORAGE (AWS S3 / Cloudflare R2) ---
# Usado para upload de logos e fotos de produtos
AWS_BUCKET_NAME=mesaflow-assets
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=xxxx
AWS_SECRET_ACCESS_KEY=xxxx
AWS_ENDPOINT_URL= # Preencha apenas se usar R2 ou MinIO

# --- FRONTEND / MOBILE ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_ROOT_DOMAIN=localhost
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
