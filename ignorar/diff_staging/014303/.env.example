# ==============================================================================
# MESAFLOW OS — MASTER ENVIRONMENT TEMPLATE (GOLD MASTER)
# LAST_MODIFIED: 2026-01-15
# ==============================================================================

# --- CORE ---
ENVIRONMENT=development
SECRET_KEY=generate_a_secure_hex_32_chars
DATABASE_URL=postgresql://user:pass@host:5432/db
REDIS_URL=redis://localhost:6379/0

# --- OBSERVABILITY (SENTRY) ---
SENTRY_DSN_BACKEND=https://key@o0.ingest.sentry.io/id
NEXT_PUBLIC_SENTRY_DSN=https://key@o0.ingest.sentry.io/id

# --- PAYMENTS: MERCADO PAGO (Operational) ---
# Usado para Pix na mesa e Split de comissões
MP_ACCESS_TOKEN=APP_USR-xxxx-xxxx
MP_APP_ID=xxxx
MP_CLIENT_SECRET=xxxx
MP_REDIRECT_URI=https://sua-api.com/api/admin/payment/callback/mercadopago

# --- PAYMENTS: STRIPE (SaaS Billing) ---
# Usado para cobrar a mensalidade dos lojistas
STRIPE_SECRET_KEY=sk_live_xxxx
STRIPE_PRO_PRICE_ID=price_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx

# --- COMMUNICATION: WHATSAPP (Evolution API) ---
WHATSAPP_API_URL=https://api.sua-instancia.com
WHATSAPP_API_TOKEN=sua_api_key_segura
WHATSAPP_INSTANCE=MesaFlow_Default

# --- MARKETPLACE: IFOOD ---
IFOOD_CLIENT_ID=xxxx
IFOOD_CLIENT_SECRET=xxxx
IFOOD_WEBHOOK_SECRET=xxxx

# --- FISCAL: FOCUS NFE ---
FISCAL_PROVIDER=focus
FISCAL_ENV=sandbox
FISCAL_TOKEN=xxxx
FISCAL_PRODUCTION_CONFIRMED=false

# --- FRONTEND ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
