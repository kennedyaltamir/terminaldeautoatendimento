{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    /* 🛡️ RITO DE ISOLAMENTO VIBRANIUM 🛡️ */
    /* 1. Impede que o TS busque tipos em pastas superiores (C:/mesaflow/node_modules) */
    "typeRoots": [
      "./node_modules/@types"
    ],
    /* 2. Carrega apenas tipos estritamente necessários para Web, eliminando React-Native */
    "types": [
      "node",
      "react",
      "react-dom"
    ],
    /* 3. Garante que o compilador não tente carregar arquivos de fora da pasta frontend */
    "rootDir": "."
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "../node_modules",
    "../mobile",
    "../backend"
  ]
}
