import { NextResponse } from "next/server";
import type { NextRequest } from "next/server";

export async function middleware(req: NextRequest) {
  const { pathname } = req.nextUrl;
  const token = req.cookies.get("auth_token")?.value;
  
  // 🛡️ PROTOCOLO DE AUDITORIA: Permite bypass se o header de teste estiver presente
  const isE2E = req.headers.get('x-e2e-test') === 'true';

  const isPublicRoute = 
    pathname === "/" ||
    pathname === "/offline" ||
    pathname.startsWith("/trust") ||
    pathname.includes("/menu") ||   
    pathname.includes("/kiosk") ||
    pathname.includes("/checkout") || 
    pathname.includes("/monitor");

  if (isPublicRoute || pathname.startsWith("/_next") || pathname.includes(".")) {
    return NextResponse.next();
  }

  // 🛡️ HARDENING: Se for rota administrativa e não houver token, redireciona, exceto em E2E
  if (pathname.startsWith("/admin") && !pathname.includes("/login")) {
    if (!token && !isE2E) {
      const loginUrl = new URL("/admin/login", req.url);
      return NextResponse.redirect(loginUrl);
    }
  }

  const requestHeaders = new Headers(req.headers);
  requestHeaders.set("x-mesaflow-path", pathname);

  // Repassa a flag de teste para os Server Components consumirem via headers()
  if (isE2E) {
    requestHeaders.set("x-mesaflow-e2e-auth", "true");
  }

  return NextResponse.next({
    request: { headers: requestHeaders }
  });
}

export const config = {
  matcher: ["/((?!api|_next/static|_next/image|favicon.ico).*)"],
};

