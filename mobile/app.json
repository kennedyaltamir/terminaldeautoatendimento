
{
  "expo": {
    "name": "MesaFlow KDS & POS",
    "slug": "terminaldeautoatendimento",
    "version": "1.0.0",
    "scheme": "mesaflow",
    "runtimeVersion": "1.0.0",
    "newArchEnabled": true,
    "platforms": ["ios", "android", "web"],
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.mesaflow.mobile",
      "permissions": [
        "VIBRATE",
        "INTERNET",
        "CAMERA"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": {
            "scheme": "mesaflow"
          },
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "ios": {
      "bundleIdentifier": "com.mesaflow.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Necessário para ler QR Codes de mesa."
      }
    }
  }
}

