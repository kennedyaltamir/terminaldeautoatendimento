{
  "cli": {
    "version": ">= 7.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "APP_ENV": "development",
        "API_URL": "http://localhost:8000/api"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "APP_ENV": "staging",
        "API_URL": "https://staging-api.mesaflow.com.br/api"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "distribution": "store",
        "resourceClass": "m1-medium"
      },
      "env": {
        "APP_ENV": "production",
        "API_URL": "https://api.mesaflow.com.br/api"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "../google-service-account.json",
        "track": "internal"
      },
      "ios": {
        "appleId": "deploy@mesaflow.com.br",
        "ascAppId": "6445891234",
        "appleTeamId": "TEAM123456"
      }
    }
  }
}
