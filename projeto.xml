<?xml version="1.0" encoding="UTF-8"?>
<MesaFlowMetaExplanation version="13.0" status="SOVEREIGN_CONTEXT_EXPANDED">
    <!-- 
        @context: Este documento serve como a "Verdade Absoluta" e o "Mapa Cognitivo" do MesaFlow OS. 
        Ele expande o protocolo forense original para fornecer contexto total a humanos e IAs.
        @notes: O sistema é projetado sob o paradigma de "Soberania de Dados" e "Integridade Incontestável".
    -->

    <ProjectOverview>
        <Identity designation="MesaFlow OS" version="13.0.0">
            <Purpose>
                @context: Sistema Operacional Omnichannel para Food Service, Eventos e Hotelaria.
                @usage: Orquestração de pedidos, pagamentos em tempo real, produção em cozinha (KDS) e logística de última milha.
                @notes: Focado em alta densidade de tráfego e resiliência offline-first.
            </Purpose>
        </Identity>
    </ProjectOverview>

    <ConfigurationSection>
        <GlobalParameters>
            <Param name="ENVIRONMENT" type="String">
                @context: Define o rigor das validações e o comportamento do Circuit Breaker.
                @usage: 'development' permite bypass de certas travas de segurança para debug; 'production' ativa o modo Sovereign Absolute.
                @security: Em produção, falhas de integridade resultam em HALT_SYSTEM imediato.
            </Param>
            <Param name="DATABASE_URL" type="ConnectionURI">
                @context: Ponto de persistência central (PostgreSQL).
                @dependencies: Requer driver 'psycopg2-binary' e suporte a Row-Level Security (RLS).
                @security: A string de conexão deve ser protegida; vazamentos permitem acesso direto ao banco, embora o RLS mitigue vazamentos entre tenants.
            </Param>
            <Param name="REDIS_URL" type="ConnectionURI">
                @context: Backbone para cache e mensageria em tempo real (Pub/Sub).
                @usage: Sincroniza eventos de WebSocket entre múltiplas instâncias do backend.
                @dependencies: Essencial para o funcionamento do KDS e notificações do Garçom.
            </Param>
        </GlobalParameters>

        <EnumsParameters>
            <Enum name="OrderStatus">
                @context: Máquina de estados que governa o ciclo de vida de um pedido.
                <Value code="pending">
                    @context: Estado inicial. Pedido criado mas não pago ou não aceito.
                    @notes: Bloqueia a exibição no KDS principal para evitar produção sem garantia financeira.
                </Value>
                <Value code="accepted">
                    @context: Confirmação de pagamento ou autorização manual.
                    @notes: Dispara o trigger de "Novo Pedido" via WebSocket para a cozinha.
                </Value>
                <Value code="preparing">
                    @context: Pedido em produção física.
                    @notes: Inicia o cronômetro de SLA de produção.
                </Value>
                <Value code="ready">
                    @context: Item finalizado. Aguardando retirada ou entregador.
                    @notes: Notifica o cliente via WhatsApp/Push e o garçom via App.
                </Value>
                <Value code="delivered">
                    @context: Ciclo concluído.
                    @artifacts: Gera entrada de crédito no Financial Ledger e debita insumos do estoque.
                </Value>
            </Enum>

            <Enum name="PaymentStatus">
                @context: Estado financeiro da transação.
                <Value code="paid">
                    @context: Liquidação confirmada pelo gateway (Mercado Pago/Stripe).
                    @usage: Gatilho automático para mudar OrderStatus para 'accepted'.
                    @security: Requer validação de assinatura HMAC no Webhook para evitar fraudes.
                </Value>
            </Enum>
        </EnumsParameters>
    </ConfigurationSection>

    <SecretsVault>
        <!-- 
            @security: O comprometimento de qualquer segredo nesta seção exige a rotação imediata de todas as chaves.
        -->
        <Secret name="SECRET_KEY">
            @context: Chave simétrica para assinatura de tokens JWT.
            @security: Risco Crítico. Permite forjar identidades de 'Owner' ou 'Admin'.
        </Secret>
        <Secret name="SUPER_ADMIN_SECRET">
            @context: Chave de acesso para o modo Impersonate (Suporte Técnico).
            @usage: Permite que a equipe de suporte acesse o painel de um cliente sem a senha dele.
            @security: Deve ser restrita a IPs específicos e logada no Audit Trail imutável.
        </Secret>
        <Secret name="MP_ACCESS_TOKEN">
            @context: Token de API do Mercado Pago.
            @usage: Geração de Pix Dinâmico e estornos.
            @security: Permite movimentação financeira. Deve ser armazenado em Vault criptografado.
        </Secret>
    </SecretsVault>

    <ArchitectureLayers>
        <Layer id="L1" name="Database (PostgreSQL + RLS)">
            @context: Camada de persistência com isolamento multi-tenant nativo.
            @security: Implementa Row-Level Security. O banco nega acesso a dados se 'app.current_company_id' não estiver definido na sessão.
        </Layer>
        <Layer id="L2" name="Backend (FastAPI)">
            @context: Motor de regras de negócio e API Gateway.
            @notes: Utiliza Pydantic para garantir que nenhum dado "sujo" entre no sistema.
        </Layer>
        <Layer id="L3" name="Real-time (Redis + WebSockets)">
            @context: Camada de baixa latência para sincronização operacional.
            @dependencies: Depende da estabilidade do Redis para evitar "cegueira" na cozinha.
        </Layer>
        <Layer id="L4" name="Frontend (Next.js SPA)">
            @context: Interface do usuário final e administrativa.
            @notes: Implementa Offline-First para garantir que o garçom não pare de trabalhar se o Wi-Fi oscilar.
        </Layer>
    </ArchitectureLayers>

    <ExecutionFlow>
        <Step id="1" name="Vital_Signs_Audit">
            @context: Verificação de prontidão da infraestrutura.
            @usage: Executado antes de qualquer rito forense.
            @artifacts: Status de portas 8000 (API) e 3000 (UI).
            @notes: Se o backend estiver offline, o sistema entra em modo HALT.
        </Step>

        <Step id="2" name="Inventory_Mapping">
            @context: Descoberta dinâmica da superfície de ataque e navegação.
            @dependencies: Step 1.
            @artifacts: 'page_inventory.json'.
            @usage: Mapeia todas as rotas do Next.js para garantir cobertura total de testes.
        </Step>

        <Step id="3" name="Auth_Bridge_Establishment">
            @context: Criação de túnel autenticado para o auditor.
            @usage: Realiza login como 'admin@mesaflow.com' e captura o estado da sessão.
            @artifacts: 'auth_state.json'.
            @security: O token capturado é usado para validar rotas protegidas por RLS.
        </Step>

        <Step id="4" name="Transactional_Autopsy">
            @context: Simulação de um ciclo de venda real (End-to-End).
            @usage: Cria um pedido no Kiosk, simula pagamento e verifica persistência.
            @dependencies: Step 3.
            @artifacts: 'order_id' para rastreamento nos passos seguintes.
            @notes: Valida se o cálculo de impostos e taxas de serviço está correto.
        </Step>

        <Step id="5" name="Operational_Sync_Validation">
            @context: Verifica se a mensagem de "Novo Pedido" viajou corretamente.
            @usage: Checa se o KDS (Cozinha) e o App do Garçom receberam o evento do Step 4.
            @dependencies: Step 4.
            @security: Garante que não há "pedidos fantasmas" (pagos mas não produzidos).
        </Step>

        <Step id="6" name="Financial_Ledger_Reconciliation">
            @context: Auditoria final de integridade monetária.
            @usage: Cruza o valor do pedido com o 'financial_ledger' e verifica o hash de integridade.
            @artifacts: 'reconciliation_report.json'.
            @security: Detecta se houve alteração manual de valores no banco de dados.
        </Step>
    </ExecutionFlow>

    <SecurityModel>
        <Protocol name="RLS_Enforcement">
            @context: Garantia de isolamento entre empresas.
            @usage: Aplicado em todas as tabelas core (orders, products, employees).
            @security: Impede que um atacante com token da Empresa A acesse dados da Empresa B.
        </Protocol>
        <Protocol name="Webhook_HMAC_Validation">
            @context: Proteção contra injeção de pagamentos falsos.
            @usage: O backend calcula o hash do payload recebido e compara com o header 'X-Signature'.
            @security: Sem isso, um atacante pode marcar pedidos como 'PAID' sem pagar.
        </Protocol>
        <Protocol name="Kiosk_Sandbox_Hardening">
            @context: Proteção física do terminal de autoatendimento.
            @usage: Bloqueia teclas de sistema (F12, Alt+Tab) e força modo Fullscreen.
            @notes: Se o Fullscreen for violado, o sistema entra em 'BREACHED' e exige senha mestre.
        </Protocol>
    </SecurityModel>

    <OutputSchema>
        <Artifact name="FORENSIC_REPORT" format="JSON">
            @context: Registro técnico detalhado de uma execução forense.
            @usage: Usado para debugging profundo e auditoria de conformidade.
            <Fields>execution_id, timestamp, anomalies_list, performance_metrics, integrity_hashes</Fields>
        </Artifact>
        <Artifact name="EXECUTIVE_DASHBOARD" format="HTML">
            @context: Visão de alto nível para gestores.
            @usage: Mostra o status de saúde do sistema (Verde/Amarelo/Vermelho).
        </Artifact>
    </OutputSchema>

    <StatusMeanings>
        <Status code="PASSED">
            @context: Sistema operando em conformidade total com os protocolos L6.
        </Status>
        <Status code="DEGRADED">
            @context: Sistema funcional, mas com falhas de performance ou erros não-críticos (ex: console warnings).
            @notes: Requer manutenção preventiva, mas não bloqueia a operação.
        </Status>
        <Status code="FAILED">
            @context: Violação de integridade ou crash de runtime detectado.
            @security: Risco de perda financeira ou de dados. Exige intervenção imediata.
        </Status>
        <Status code="INEXECUTABLE">
            @context: O ambiente de teste/auditoria não pôde ser estabelecido.
            @usage: Geralmente causado por falha de rede ou banco de dados offline.
        </Status>
    </StatusMeanings>
</MesaFlowMetaExplanation>
