<?xml version="1.0" encoding="UTF-8"?>
<MesaFlowSovereignContext version="13.0" status="ULTIMATE_FORENSIC_EXPANSION">
    <!-- 
        @context: Este documento é a expansão definitiva do MesaFlow OS v13.0. 
        Ele integra arquitetura, segurança, fluxos operacionais e análise de risco em um único grafo de conhecimento.
        @usage: Base para Auditoria Forense, Engenharia Reversa e Treinamento de Agentes de IA de Nível 2.
    -->

    <ProjectOverview>
        <VersioningImpact>
            <Version id="v11.0" status="LEGACY_COMPATIBLE">
                @context: Introdução do DNA Digital e modularização de Schemas.
                @notes: Migração de schemas exige scripts de 'alembic upgrade' para evitar perda de metadados de auditoria.
            </Version>
            <Version id="v13.0" status="CURRENT_SOVEREIGN">
                @context: Implementação do Kernel de Singularidade e RLS Absoluto.
                @notes: Incompatibilidade total com bancos de dados sem suporte a Row-Level Security.
            </Version>
        </VersioningImpact>

        <InfrastructureConstraints>
            <Constraint type="NETWORK">
                @context: Portas 8000 (API), 3000 (Frontend) e 6379 (Redis) devem estar abertas e exclusivas.
                @security: Firewalls devem permitir tráfego de entrada apenas para o Gateway (Nginx/Vercel) e bloquear acesso direto ao DB.
            </Constraint>
            <Constraint type="EXTERNAL_DEPENDENCY">
                @context: Mercado Pago (Pix), Stripe (SaaS), FocusNFe (Fiscal), BrasilAPI (CNPJ).
                @notes: A indisponibilidade de qualquer um destes serviços degrada o status para 'DEGRADED' mas não interrompe o KDS local.
            </Constraint>
        </InfrastructureConstraints>
    </ProjectOverview>

    <ConfigurationSection>
        <GlobalParams>
            <Param name="ENVIRONMENT">
                <Behavior if_missing="DEFAULT_TO_DEV">
                    @context: Assume 'development'. Desativa validações estritas de SSL e HMAC.
                    @security: RISCO ALTO. Permite ataques de injeção em ambiente local.
                </Behavior>
            </Param>
            <Param name="DATABASE_URL">
                <Behavior if_malformed="BOOT_CRASH">
                    @context: O SQLAlchemy falha ao instanciar o engine. O sistema entra em HALT.
                </Behavior>
                <Failover strategy="PITR_RECOVERY">
                    @notes: Recuperação de ponto no tempo via Neon/AWS RDS.
                </Failover>
            </Param>
            <Param name="REDIS_URL">
                <Behavior if_absent="LOCAL_MEMORY_FALLBACK">
                    @context: O WebSocket funciona apenas no processo atual.
                    @notes: Em clusters (múltiplas instâncias), a cozinha fica "cega" para pedidos vindos de outros servidores.
                </Behavior>
            </Param>
        </GlobalParams>

        <EnumImpactAnalysis>
            <Enum name="OrderStatus">
                @context: Mudanças de valor impactam o KDS (UI) e o Financial Ledger (Triggers).
                <Impact layer="Frontend">Altera cores dos cards e visibilidade no monitor.</Impact>
                <Impact layer="FinancialLedger">Status 'delivered' dispara o fechamento da transação e cálculo de cashback.</Impact>
            </Enum>
        </EnumImpactAnalysis>
    </ConfigurationSection>

    <SecretsVault>
        <Secret name="SECRET_KEY">
            <CompromiseScenario>
                @context: Atacante gera tokens JWT válidos para qualquer empresa.
                @security: Violação total de privacidade.
                <Mitigation>Rotação imediata da chave e limpeza da blacklist no Redis (Token Revocation).</Mitigation>
            </CompromiseScenario>
        </Secret>
        <Secret name="MP_ACCESS_TOKEN">
            <CompromiseScenario>
                @context: Atacante desvia pagamentos Pix para outra conta.
                <Mitigation>Revogação do token no painel do Mercado Pago e atualização via 'admin_payment.py'.</Mitigation>
            </CompromiseScenario>
        </Secret>
    </SecretsVault>

    <ArchitectureLayers>
        <Layer id="L1" name="Database">
            <DataFlow direction="IN">Queries SQL, Contexto de Tenant (SET LOCAL).</DataFlow>
            <DataFlow direction="OUT">ResultSets filtrados por RLS.</DataFlow>
            <Thresholds latency_max="100ms" alert_at="500ms" />
            <SPOF status="CRITICAL">Ponto único de falha. Mitigado por réplicas de leitura.</SPOF>
        </Layer>
        <Layer id="L3" name="Real-time_Messaging">
            <DataFlow direction="IN">Eventos de Pedido, Telemetria GPS.</DataFlow>
            <Thresholds latency_max="50ms" alert_at="200ms" />
            <Dependencies>Step 5 (Operational Sync).</Dependencies>
        </Layer>
    </ArchitectureLayers>

    <ExecutionFlow>
        <Step id="1" name="Vital_Signs">
            <Artifacts>PortStatusMap</Artifacts>
            <Logs>INFRA_CHECK_INIT, PORT_8000_OK, PORT_3000_OK</Logs>
            <StatusMapping passed="All ports open" inexecutable="Any port closed" />
        </Step>

        <Step id="4" name="Transactional_Autopsy">
            <Artifacts>order_id, pix_payload, db_snapshot_pre_post</Artifacts>
            <PartialFailureScenario if="Payment_Confirmed_But_KDS_Offline">
                @context: O pedido é salvo como 'PAID' no DB, mas o evento WS falha.
                @notes: O sistema reage via Polling de fallback no KDS (30s).
            </PartialFailureScenario>
        </Step>
    </ExecutionFlow>

    <SecurityModel>
        <Protocol name="RLS_Enforcement">
            <AttackVector>Cross-tenant ID enumeration (IDOR).</AttackVector>
            <Mitigation>O banco de dados rejeita a query se o ID da empresa no token não bater com o 'company_id' da linha.</Mitigation>
            <PenTest>Tentativa de acessar /api/admin/orders/123 usando token de outra empresa.</PenTest>
        </Protocol>
        <Protocol name="Webhook_HMAC">
            <AttackVector>Pix Spoofing (Injeção de pagamento falso).</AttackVector>
            <Mitigation>Validação obrigatória do header 'X-Signature' usando a chave secreta do iFood/MP.</Mitigation>
        </Protocol>
    </SecurityModel>

    <OutputSchema>
        <Artifact name="FORENSIC_REPORT">
