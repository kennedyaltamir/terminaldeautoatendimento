<?xml version="1.0" encoding="UTF-8"?>
<MesaFlowForensicProtocol version="13.0" status="GOLD_MASTER_SEALED">
    <ProjectExplanation>
        <MetaInformation>
            <ProjectName>MesaFlow OS (Operating System for Food Service)</ProjectName>
            <Version>13.0.0</Version>
            <ArchitectureStandard>L6 Forensic / SGCS 2.3</ArchitectureStandard>
            <Description>
                @context: Sistema operacional omnichannel para gestão de alta densidade em gastronomia, eventos e hotelaria.
                @usage: Utilizado para orquestrar pedidos, pagamentos (Pix/Stripe), produção (KDS) e logística de entrega.
                @notes: O projeto foca em "Resiliência Forense", garantindo que cada falha seja rastreável e cada transação financeira seja imutável.
            </Description>
        </MetaInformation>

        <!-- 1. CONFIGURAÇÃO (META, ENUMS, PARÂMETROS) -->
        <ConfigurationSection>
            <GlobalParameters>
                <Param name="ENVIRONMENT" value="development|production">
                    @context: Define o comportamento do sistema (tolerância a erros vs. segurança estrita).
                    @usage: Em 'development', o Circuit Breaker é mais tolerante; em 'production', bloqueia falhas imediatamente.
                </Param>
                <Param name="API_V1_STR" value="/api">
                    @context: Prefixo base para todos os endpoints REST.
                </Param>
                <Param name="DATABASE_URL" value="postgresql://...">
                    @context: String de conexão primária. 
                    @security: Deve usar SSL em produção e roles restritas (mesaflow_app).
                </Param>
            </GlobalParameters>

            <EnumsDefinitions>
                <Enum name="OrderStatus">
                    <Status value="pending">@context: Pedido criado, aguardando confirmação de pagamento ou aceite manual.</Status>
                    <Status value="accepted">@context: Pagamento confirmado ou gerente autorizou o início.</Status>
                    <Status value="preparing">@context: Pedido visível no KDS, em produção física.</Status>
                    <Status value="ready">@context: Produção finalizada, aguardando retirada ou despacho.</Status>
                    <Status value="delivering">@context: Em trânsito com o entregador (Logística ativa).</Status>
                    <Status value="delivered">@context: Ciclo finalizado, gera entrada no Financial Ledger.</Status>
                    <Status value="canceled">@context: Pedido anulado, libera estoque se configurado.</Status>
                </Enum>
                <Enum name="PaymentStatus">
                    <Status value="pending">Aguardando processamento do gateway ou confirmação manual.</Status>
                    <Status value="paid">Transação liquidada. Gatilho para KDS.</Status>
                    <Status value="failed">Transação recusada. Bloqueia criação do pedido.</Status>
                </Enum>
                <Enum name="PlanTier">
                    <Tier value="free">Limite de 50 pedidos/mês e 15 produtos.</Tier>
                    <Tier value="pro">Pedidos ilimitados, KDS ativo, Gestão de Estoque.</Tier>
                    <Tier value="enterprise">White-label, API dedicada, suporte 24/7.</Tier>
                </Enum>
            </EnumsDefinitions>
        </ConfigurationSection>

        <!-- 2. SEGREDOS (ORIGEM E USO) -->
        <SecretsVault>
            <Secret name="SECRET_KEY">
                @context: Chave de assinatura para tokens JWT.
                @security: Se vazada, permite personificação de qualquer usuário.
            </Secret>
            <Secret name="SUPER_ADMIN_SECRET">
                @context: Chave mestre para o modo "Impersonate" (Suporte).
                @usage: Enviada no header 'X-Super-Secret' para assumir o controle de um tenant.
            </Secret>
            <Secret name="MP_ACCESS_TOKEN">
                @context: Token de produção do Mercado Pago.
                @usage: Utilizado para gerar Pix Dinâmico e processar Webhooks.
            </Secret>
            <Secret name="IFOOD_WEBHOOK_SECRET">
                @context: Chave HMAC para validar se o evento veio realmente do iFood.
                @security: Protege contra ataques de injeção de pedidos falsos.
            </Secret>
        </SecretsVault>

        <!-- 3. ARQUITETURA (CAMADAS E COMPORTAMENTO) -->
        <ArchitectureLayers>
            <Layer name="Backend (FastAPI)" priority="1">
                @context: Núcleo de processamento assíncrono.
                @dependencies: SQLAlchemy (ORM), Pydantic (Schemas), Redis (Cache).
                @notes: Implementa o "Circuit Breaker" para proteger o banco de dados em picos de carga.
            </Layer>
            <Layer name="Frontend (Next.js 14+)" priority="2">
                @context: Interface SPA (Single Page Application) com App Router.
                @usage: Utiliza "Client Components" para interatividade e "Server Components" para SEO/Segurança.
                @notes: Implementa "Offline-First" via Dexie (IndexedDB) para resiliência em Wi-Fi instável.
            </Layer>
            <Layer name="Database (PostgreSQL + RLS)" priority="1">
                @context: Persistência relacional com isolamento multi-tenant nativo.
                @security: Row-Level Security (RLS) impede que a Empresa A veja dados da Empresa B, mesmo em caso de bug no código.
            </Layer>
            <Layer name="Real-time (Redis Pub/Sub)" priority="3">
                @context: Orquestrador de mensagens WebSocket.
                @usage: Sincroniza KDS, Garçom e Cliente sem necessidade de refresh.
            </Layer>
        </ArchitectureLayers>

        <!-- 4. FLUXO DE EXECUÇÃO (RITO FORENSE) -->
        <ExecutionFlow>
            <Step id="1" name="Vital Signs Check">
                <Action command="check_port(8000)">Verifica se o Backend está respondendo.</Action>
                <Action command="check_port(3000)">Verifica se o Frontend está renderizando.</Action>
                @notes: Se falhar, o rito forense é abortado para evitar falsos negativos.
            </Step>

            <Step id="2" name="Inventory Mapping">
                <Action command="generate_page_inventory.py">Varre a pasta 'src/app' e gera um mapa de rotas.</Action>
                @dependencies: Requer acesso físico ao sistema de arquivos do frontend.
                @artifacts: 'page_inventory.json'.
            </Step>

            <Step id="3" name="Auth Bridge">
                <Action command="generate_auth_state.py">Realiza login automático e captura cookies/localStorage.</Action>
                @usage: Garante que os passos seguintes tenham permissão administrativa.
                @artifacts: 'auth_state.json'.
            </Step>

            <Step id="4" name="Transactional Autopsy">
                <Action command="system_autopsy_v1.py">
                    1. Abre o cardápio público.
                    2. Adiciona item ao carrinho.
                    3. Finaliza pedido via Pix.
                    4. Captura o ID do pedido gerado.
                </Action>
                @context: Valida se o funil de vendas está quebrado.
            </Step>

            <Step id="5" name="Operational Sync Verification">
                <Action command="KDS_Check">Verifica se o ID do pedido do Step 4 apareceu no monitor de cozinha.</Action>
                <Action command="Waiter_Check">Verifica se a mesa foi marcada como 'Ocupada' no app do garçom.</Action>
                @dependencies: Depende do sucesso do Step 4.
            </Step>

            <Step id="6" name="Financial Integrity Audit">
                <Action command="reconcile_company()">Cruza o pedido criado com o Financial Ledger.</Action>
                @security: Verifica se o hash de integridade (SHA-256) da transação é válido.
            </Step>
        </ExecutionFlow>

        <!-- 5. ESQUEMA DE SAÍDA (RELATÓRIOS E ARTEFATOS) -->
        <OutputSchema>
            <Artifact type="JSON" name="FORENSIC_REPORT">
                <Requirement>Deve conter timestamp ISO-8601.</Requirement>
                <Requirement>Deve listar todas as anomalias detectadas com severidade.</Requirement>
                <Requirement>Deve incluir o 'execution_id' para correlação de logs.</Requirement>
            </Artifact>
            <Artifact type="PNG" name="INCIDENT_SCREENSHOT">
                <Requirement>Capturado automaticamente em caso de erro 4xx, 5xx ou JS Crash.</Requirement>
            </Artifact>
            <Artifact type="Markdown" name="ARCHITECTURE_REPORT">
                <Requirement>Sumário executivo para tomada de decisão humana.</Requirement>
            </Artifact>
        </OutputSchema>

        <!-- 6. SEGURANÇA (PROTOCOLOS E VALIDAÇÃO) -->
        <SecurityModel>
            <Protocol name="RLS_ENFORCEMENT">
                @context: Isolamento de dados no banco.
                @usage: Todo request deve executar 'SET LOCAL app.current_company_id = ...' antes da query.
            </Protocol>
            <Protocol name="WEBHOOK_IDEMPOTENCY">
                @context: Previne processamento duplo de pagamentos.
                @usage: Verifica se o 'external_id' já existe na tabela 'payment_transactions' antes de liberar o pedido.
            </Protocol>
            <Protocol name="KIOSK_HARDENING">
                @context: Proteção do Totem físico.
                @usage: Bloqueia saída do Fullscreen sem senha e desabilita menu de contexto (botão direito).
            </Protocol>
        </SecurityModel>

        <StatusMeanings>
            <Status code="PASSED">O fluxo foi executado sem erros de contrato ou runtime.</Status>
            <Status code="DEGRADED">O fluxo funcionou, mas com latência alta ou erros não-críticos de console.</Status>
            <Status code="FAILED">O sistema crashou ou houve violação de integridade de dados.</Status>
            <Status code="INEXECUTABLE">O ambiente não atende aos pré-requisitos (ex: DB offline).</Status>
        </StatusMeanings>
    </ProjectExplanation>
</MesaFlowForensicProtocol>
