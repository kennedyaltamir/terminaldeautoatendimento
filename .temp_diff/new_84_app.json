{
  "expo": {
    "name": "MesaFlow KDS & POS",
    "slug": "terminaldeautoatendimento",
    "owner": "kennedyaltamir",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F172A",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mesaflow.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "UIBackgroundModes": [
          "fetch",
          "remote-notification"
        ],
        "NSCameraUsageDescription": "O MesaFlow precisa de acesso à câmera para ler QR Codes de mesa."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "package": "com.mesaflow.mobile",
      "permissions": [
        "VIBRATE",
        "INTERNET",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "6c399079-8815-4995-ad7d-7b23c6fa1769"
      }
    },
    "plugins": [
      "expo-notifications",
      "expo-secure-store"
    ]
  }
}
