# ==============================================================================
# MESAFLOW OS - TEMPLATE DE AMBIENTE (v3.0 Enterprise)
# ==============================================================================

# --- CORE & DATABASE ---
ENVIRONMENT=development
DEBUG=True
# Para Docker: postgresql://postgres:postgres@db:5432/mesaflow_db
# Para Local: postgresql://usuario:senha@localhost:5432/mesaflow_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mesaflow_db
REDIS_URL=redis://localhost:6379/0

# --- SECURITY ---
# Gere com: openssl rand -hex 32
SECRET_KEY=changeme
SUPER_ADMIN_SECRET=changeme_god_mode_key

# --- FINTECH (PAGAMENTOS) ---
# Stripe (Assinaturas SaaS)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...

# Mercado Pago (Split de Vendas)
MP_APP_ID=YOUR_MP_APP_ID
MP_CLIENT_SECRET=YOUR_MP_CLIENT_SECRET
MP_REDIRECT_URI=http://localhost:3000/admin/payment/callback

# --- LOGISTICS & INTEGRATIONS ---
# iFood
IFOOD_CLIENT_ID=YOUR_IFOOD_ID
IFOOD_CLIENT_SECRET=YOUR_IFOOD_SECRET
IFOOD_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# WhatsApp (Evolution API)
WHATSAPP_API_URL=http://localhost:8080
WHATSAPP_API_TOKEN=YOUR_TOKEN
WHATSAPP_INSTANCE=MesaFlow_Main

# --- INFRASTRUCTURE ---
# E-mail (SMTP)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu@email.com
SMTP_PASSWORD=sua_senha_app
SMTP_FROM_EMAIL=noreply@mesaflow.com.br

# Storage (S3 / R2 / MinIO)
AWS_BUCKET_NAME=mesaflow-assets
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_KEY
# Deixe vazio para AWS S3 real. Preencha para Cloudflare R2 ou MinIO local.
AWS_ENDPOINT_URL=

# --- OBSERVABILITY ---
SENTRY_DSN_BACKEND=
NEXT_PUBLIC_SENTRY_DSN=

# --- FRONTEND PUBLIC ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_ROOT_DOMAIN=localhost